# CryptoBot environment template.
#
# The setup script copies this to `.env` and fills POSTGRES_PASSWORD and
# APPROVAL_TOKEN with random values. `.env` is git-ignored — never commit
# it. Values below are the defaults.

# ── Execution mode ──────────────────────────────────────────────────────
# dry-run (default) | paper | live. Live places REAL orders on Binance and
# requires BINANCE_API_KEY, BINANCE_API_SECRET and APPROVAL_TOKEN.
EXECUTION_MODE=dry-run
# Shown in the dashboard mode chip (build-time for the frontend image).
NEXT_PUBLIC_EXECUTION_MODE=dry-run

# ── Network ─────────────────────────────────────────────────────────────
# Host interface the docker ports bind to. 127.0.0.1 keeps the stack off
# the LAN; set 0.0.0.0 only behind your own firewall / reverse proxy.
BIND_ADDR=127.0.0.1
BACKEND_PORT=8081
FRONTEND_PORT=3002
# Host port for Ollama; change if a native Ollama already uses 11434.
OLLAMA_PORT=11434
# Browser origins allowed by CORS and the WebSocket (comma-separated).
ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
# URLs the browser uses to reach the backend.
NEXT_PUBLIC_API_URL=http://localhost:8081
NEXT_PUBLIC_WS_URL=ws://localhost:8081/ws
# Comma-separated proxy CIDRs to trust for X-Forwarded-For. Empty = none.
TRUSTED_PROXIES=

# ── Operator token ──────────────────────────────────────────────────────
# Bearer token for approving live signals, resetting the circuit breaker
# and starting backtests. Enter the same value in the dashboard Settings.
# Required in live mode. Generate: openssl rand -hex 32
APPROVAL_TOKEN=
SIGNAL_APPROVAL_TTL_SEC=60
SIGNAL_PENDING_MAX=10
APPROVAL_EXECUTING_MAX_AGE_SEC=60

# ── Database (TimescaleDB in docker compose) ────────────────────────────
# POSTGRES_HOST=postgres inside docker compose; localhost when running the
# backend directly with `go run`.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=cryptobot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cryptobot
POSTGRES_SSLMODE=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_LIFETIME_MIN=0
POSTGRES_CONN_MAX_IDLE_MIN=0

# ── Data retention (days; 0 disables a rule) ────────────────────────────
CANDLE_1M_RETENTION_DAYS=30
CANDLE_INTRADAY_RETENTION_DAYS=90
AUDIT_TEXT_RETENTION_DAYS=30
RETENTION_INTERVAL=24h

# ── AI ──────────────────────────────────────────────────────────────────
AI_PROVIDER=ollama
# Overridden to http://ollama:11434 inside docker compose.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Binance ─────────────────────────────────────────────────────────────
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
# Only needed for EXECUTION_MODE=live. Use a key with trading enabled and
# withdrawals DISABLED, restricted to your IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_RECV_WINDOW_MS=5000

# ── Strategy / risk ─────────────────────────────────────────────────────
EXECUTOR_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT
PRIORITY_SYMBOL=ETHUSDT
EXECUTOR_TICK_INTERVAL=5m
POSITION_MONITOR_INTERVAL=5s
RISK_MAX_POSITION_PCT=2.0
RISK_DAILY_DRAWDOWN_PCT=5.0
RISK_MAX_OPEN_POSITIONS=3
MAX_SLIPPAGE_BPS=50
MIN_EXPECTED_RETURN_BPS=30
MAX_STOP_LOSS_PCT=5.0
TRAILING_STOP_PCT=2.0
TRAILING_STOP_ARM_PCT=1.0
MIN_LOCKED_PROFIT_PCT=0.5
# Simulated per-leg fee for paper / dry-run (0.001 = 0.1%).
PAPER_FEE_RATE=0.001

# ── Debug ───────────────────────────────────────────────────────────────
ENABLE_PPROF=false
PPROF_ADDR=:6060
